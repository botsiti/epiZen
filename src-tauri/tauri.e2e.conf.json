{
  "build": {
    "beforeBuildCommand": "npm run build:e2e-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Epizen",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visibleOnAllWorkspaces": false,
        "theme": "Dark",
        "backgroundColor": "#121416",
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "tray",
        "pet",
        "prompt",
        {
          "identifier": "e2e",
          "description": "Test-only: lets WebdriverIO drive the window. Only in `npm run build:e2e`.",
          "windows": [
            "main",
            "spike",
            "spike-prompt"
          ],
          "permissions": [
            "core:default",
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-position",
            "core:window:allow-show",
            "core:window:allow-close"
          ]
        }
      ]
    }
  }
}
